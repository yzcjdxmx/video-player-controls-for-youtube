{
  "manifest_version": 3,
  "name": "Video Player Controls for YouTube",
  "version": "1.4.0",
  "description": "让 YouTube 网页播放器按哔哩哔哩的操作习惯走:长按方向键临时倍速、Shift 逐帧、Ctrl 跳 10 秒、画面滚轮调音量、常驻进度条、指定默认清晰度。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
  "homepage_url": "https://github.com/yzcjdxmx/video-player-controls-for-youtube",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Video Player Controls for YouTube —— 点一下打开设置"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js", "progress.js", "quality.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["quality-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
